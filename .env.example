# ==========================================
# Azure Data Engineering Lab Environment Configuration
# ==========================================

# Unified Portal Config
PORTAL_BACKEND_PORT=8000
PORTAL_FRONTEND_PORT=5173

# Data Lake Storage (MinIO)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Databricks Processing (Spark / Jupyter)
JUPYTER_PORT=8888
SPARK_MASTER_PORT=8080

# Azure Data Factory (Airflow)
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Synapse DW (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=synapse_dw
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# Event Hub (Redpanda)
REDPANDA_PORT=9092
REDPANDA_CONSOLE_PORT=8081

# Service Bus (RabbitMQ)
RABBITMQ_PORT=5672
RABBITMQ_ADMIN_PORT=15672

# Azure Monitor (Grafana)
GRAFANA_PORT=3000
